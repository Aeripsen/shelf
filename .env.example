# Copy this file to .env (gitignored) before running docker compose:  cp .env.example .env
# docker-compose.yml has no password of its own and stops with an error if MSSQL_SA_PASSWORD is missing.
#
# The value below is for local development only. Every port in docker-compose.yml is bound to 127.0.0.1, so the stack
# is not reachable from other machines. It matches the password in the two appsettings.Development.json files, so
# running the API or the worker from source works unchanged. If you choose your own (SQL Server needs at least 8
# characters with three of: upper case, lower case, digits, symbols), set ConnectionStrings__Orders to match when you
# run from source. Do not reuse this value anywhere else.
# RabbitMQ keeps the image default user guest / guest, also reachable from this machine only.
MSSQL_SA_PASSWORD=Shelf_LocalDev_Only1
